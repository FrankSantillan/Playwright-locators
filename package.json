{
  "name": "playwright-locators",
  "version": "1.0.0",
  "description": "Automate \"https://the-internet.hackerearth.com/\" with Playwright + TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "npx cucumber-js --format progress --format allure-cucumberjs/reporter --require-module ts-node/register",
    "allure:generate": "npx allure generate test-results/allure-results -c -o test-results/allure-report",
    "allure:open": "npx allure open test-results/allure-report",
    "prueba": "npx cucumber-js --format allure-cucumberjs/reporter",

    "show:trace": "npx playwright show-trace test-results/traces/{my-scenario-change-the-name}.zip"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.1.0",
    "@cucumber/messages": "^28.1.0",
    "@playwright/test": "^1.54.1",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.3.2",
    "allure-playwright": "^3.3.2",
    "dotenv": "^17.2.0",
    "playwright": "^1.54.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
